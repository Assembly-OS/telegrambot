# --- Скопируйте этот файл в .env и заполните ---
# cp .env.example .env   (Windows: copy .env.example .env)

# Токен бота от @BotFather (ОБЯЗАТЕЛЬНО). Никогда не коммитьте .env в git!
BOT_TOKEN=123456:ABC-DEF...

# --- ПЛАТФОРМА ASSAMBLEYA OS (общая база и пользователи) ---
# ПУБЛИЧНЫЙ https-адрес платформы (домен или туннель cloudflared) — он
# открывается как Mini App внутри Telegram. Пусто => кнопок приложения нет.
PLATFORM_URL=
# Локальный адрес платформы: по нему бот проверяет пароль в /link. Наружу НЕ выставляется.
PLATFORM_API=http://127.0.0.1:3000
# Путь к ОБЩЕЙ БД платформы. По умолчанию ../data/assambleya.db (бот лежит рядом).
# PLATFORM_DB=../data/assambleya.db
# Надпись на кнопке-меню Mini App слева от поля ввода
MENU_BUTTON_TEXT=Platforma

# --- ВЕБХУК УВЕДОМЛЕНИЙ (платформа -> бот) ---
# Локальный веб-сервер бота слушает /notify; платформа шлёт сюда пуши при выдаче
# задачи в веб-интерфейсе, чтобы исполнителю пришло сообщение в Telegram.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Общий секрет: ДОЛЖЕН совпадать с BOT_NOTIFY_SECRET в окружении платформы.
BOT_NOTIFY_SECRET=

# --- КОНТРОЛЬ ДОСТУПА ---
# Telegram user_id, которые ВСЕГДА считаются админами (через запятую),
# даже если роль на платформе не руководящая. Свой ID — у @userinfobot.
ADMIN_IDS=
