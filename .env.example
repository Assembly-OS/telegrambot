# --- Скопируйте этот файл в .env и заполните значения ---
# cp .env.example .env

# Токен бота от @BotFather (ОБЯЗАТЕЛЬНО). Никогда не коммитьте .env в git!
BOT_TOKEN=123456:ABC-DEF...

# --- Mini App (Telegram WebApp) ---
# ПУБЛИЧНЫЙ https-адрес приложения (домен или туннель cloudflared/ngrok).
# Оставьте пустым, чтобы запустить бота без кнопок приложения.
WEBAPP_URL=
# Надпись на кнопке-меню слева от поля ввода
MENU_BUTTON_TEXT=Platforma
# Локальный адрес встроенного веб-сервера (его наружу выставляет туннель).
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# --- Контроль доступа ---
# Telegram user_id, которые ВСЕГДА являются админами (через запятую).
# Свой ID можно узнать у @userinfobot.
ADMIN_IDS=

# Пароль для команды «/admin_login <пароль>».
# Оставьте пустым, чтобы полностью отключить самоповышение до админа.
ADMIN_SECRET=
